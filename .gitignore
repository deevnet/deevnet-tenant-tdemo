# Terraform state is NOT committed. It holds this tenant every credential
# (ADR-0015 §4), so it belongs in the state store or somewhere with the same care.
terraform.tfstate
terraform.tfstate.backup
.terraform/
*.tfplan
.terraform.tfstate.lock.info

# The Deevnet Root CA: from tenant-check.sh --write-ca . or the operator. Not secret,
# but it changes if the site's CA is rebuilt, so it is fetched, not committed.
deevnet-root-ca.pem
deevnet-mobile-root-ca.pem
site-ca.pem

# The state store's credentials, written by `make state-backend`. Secret.
.backend.env

# The app's environment, from `terraform output -raw kit_env`. Secret.
kit.env

# Provider pins ARE committed once the provider is published; until then the
# lock file would name a local build.

# A failed apply or destroy writes the state it could not persist here, and it
# holds the same credentials the state does.
errored.tfstate

# The lock file pins provider checksums, and until deevnet/deevnet is published
# or mirrored (ADR-0012 §7) the only source is a locally built binary whose
# hash is nobody else's. It comes back with the mirror.
.terraform.lock.hcl
