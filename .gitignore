# Terraform state is NOT committed. It holds this tenant every credential
# (ADR-0015 §4), so it belongs in the state store or somewhere with the same care.
terraform.tfstate
terraform.tfstate.backup
.terraform/
*.tfplan
.terraform.tfstate.lock.info

# Issued at admission, never committed.
site-ca.pem

# Provider pins ARE committed once the provider is published; until then the
# lock file would name a local build.
