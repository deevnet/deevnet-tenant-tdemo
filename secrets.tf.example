# Runtime secrets in your own OpenBao namespace (ADR-0021). Optional: copy this
# file to secrets.tf to use it. Needs Terraform 1.11 or later.
#
# The value never reaches your plan or your state: `data_wo` is write-only, and
# the variable feeding it is ephemeral. Your repository keeps the real copy,
# encrypted with a tool of your choice, and you decrypt it into the variable at
# apply time, for example:
#
#   export TF_VAR_weather_api_key="$(age -d -i ~/.age/key.txt secrets/weather.age)"
#   terraform apply
#
# To rotate: a new value and a higher data_wo_version, then apply. The workload
# picks it up on OpenBao Agent's next render, with no rebuild and no push.

variable "weather_api_key" {
  type        = string
  sensitive   = true
  ephemeral   = true
  description = "A third-party API key your backend calls with. Never stored."
}

variable "weather_api_key_version" {
  type        = number
  default     = 1
  description = "Raise this to write a new weather_api_key."
}

resource "deevnet_secret" "weather" {
  tenant          = deevnet_tenant.this.name
  path            = "backend/weather"
  data_wo         = { api_key = var.weather_api_key }
  data_wo_version = var.weather_api_key_version
}

# The backend workload may read that path and nothing else, and only from inside
# the tenant fabric. Deleting this resource cuts it off at once.
resource "deevnet_secret_reader" "backend" {
  count    = var.backend_workload ? 1 : 0
  tenant   = deevnet_tenant.this.name
  name     = "backend"
  workload = deevnet_workload.backend[0].name
  paths    = [deevnet_secret.weather.path]
}

# Append to kit.env on the workload:
#   terraform output -raw secrets_env >> kit.env
# then run your app under scripts/run-with-secrets.sh. After an OpenBao
# rebuild, the next apply issues a new credential: write kit.env and push again.
output "secrets_env" {
  sensitive = true
  value = var.backend_workload ? join("\n", [
    "BAO_ADDR=${deevnet_secret_reader.backend[0].addr}",
    "BAO_NAMESPACE=${deevnet_secret_reader.backend[0].namespace}",
    "BAO_CACERT=deevnet-root-ca.pem",
    "BAO_ROLE_ID=${deevnet_secret_reader.backend[0].role_id}",
    "BAO_SECRET_ID=${deevnet_secret_reader.backend[0].secret_id}",
    "",
  ]) : ""
}
